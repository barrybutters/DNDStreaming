{
  "name": "dungeon-director",
  "version": "0.2.0",
  "description": "Local D&D broadcast and campaign workstation",
  "author": "Dungeon Director",
  "license": "MIT",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "preview": "node app/preview.js",
    "test": "node --test test/*.test.js",
    "dist:win": "electron-builder --win nsis zip --x64 --publish never",
    "test:desktop": "electron . --smoke-test",
    "test:ui": "node test/ui-smoke.cjs"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "obs-websocket-js": "^5.0.6"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^29.0.2"
  },
  "build": {
    "appId": "local.dungeondirector.desktop",
    "productName": "Dungeon Director",
    "files": [
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "artifactName": "Dungeon-Director-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Dungeon-Director-Setup-${version}.${ext}"
    },
    "extraFiles": [
      {
        "from": "build/Start-Portable.cmd",
        "to": "Start-Portable.cmd"
      }
    ]
  }
}
